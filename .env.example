# Copy to .env and fill in real values. Never commit .env.
# Variables are grouped by the phase that introduces them (see CHANGELOG.md).
# Nothing here is wired up yet in Phase 1 (docs/structure only) — this file documents the
# configuration surface the app will read once Phase 2+ lands.

# --- Phase 2: Database & Auth ---
DATABASE_URL=postgresql+asyncpg://ai_employee:ai_employee@localhost:5433/ai_employee
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Phase 2: App/API ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Phase 4: LLM Provider (abstraction layer, see docs/decisions.md ADR-005) ---
# LLM_PROVIDER selects the active provider: openai | anthropic | gemini | mock
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Phase 6: Background worker / scheduler ---
LOW_STOCK_SCAN_CRON=0 */6 * * *
DAILY_REPORT_CRON=0 8 * * *

# --- Phase 7: RAG / MCP (optional, mock adapters used if unset) ---
MCP_SERVER_URL=
EMBEDDING_MODEL=text-embedding-3-small

# --- Phase 6: Customer messaging (mock adapter unless a real key is set) ---
WHATSAPP_API_KEY=
