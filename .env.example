# Copy to .env and fill in real values. Never commit .env.
# Variables are grouped by the phase that introduces them (see CHANGELOG.md).
# Nothing here is wired up yet in Phase 1 (docs/structure only) — this file documents the
# configuration surface the app will read once Phase 2+ lands.

# --- Phase 2: Database & Auth ---
DATABASE_URL=postgresql+asyncpg://postgres:Chinki@localhost:5433/ai_employee
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Phase 8: rotating refresh-token lifetime (docs/security.md).
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Phase 2: App/API ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# --- Phase 4: LLM Provider (abstraction layer, see docs/decisions.md ADR-005) ---
# LLM_PROVIDER selects the active provider: openai | anthropic | gemini | mock
# mock is deterministic (keyword rules + scripted responses) and needs no key —
# set LLM_PROVIDER=openai + OPENAI_API_KEY for real model calls. openai without
# a key falls back to mock automatically.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Embedding model used for RAG document chunks (docs/decisions.md ADR-006).
# text-embedding-3-small emits 1536-dim vectors, matching the pgvector schema.
EMBEDDING_MODEL=text-embedding-3-small

# Max LLM steps per chat request (NFR-3: no unbounded agent loops).
MAX_AGENT_STEPS=10

# --- Phase 6: Background worker / scheduler (docs/decisions.md ADR-007) ---
# How often the low-stock + forecasted-stockout scans run, and the UTC hour
# (0-23) for the daily sales report.
SCHEDULER_CHECK_INTERVAL_MINUTES=60
SCHEDULER_DAILY_REPORT_HOUR=8

# --- Phase 7: RAG / MCP (optional, mock adapters used if unset) ---
MCP_SERVER_URL=

# --- Phase 6: Customer messaging (mock adapter unless a real key is set) ---
WHATSAPP_API_KEY=

# --- Real messaging channels (optional; empty = mock rows, no real delivery) ---
# Telegram: create a bot with @BotFather (token), then message it and copy
# your chat id (or use a group id). Notifications are sent to this chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# WhatsApp Business Cloud API (Meta): app access token, the sender phone
# number id from the WhatsApp Manager, and the destination phone (E.164).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_PHONE=
